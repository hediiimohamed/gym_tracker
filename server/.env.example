# Copy this file to .env for local development (never commit the real .env).
# On Render, set these as environment variables in the service dashboard instead.

# From https://turso.tech -> create a free database -> "Connect" shows these two:
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# Any secret string you make up yourself. The app will ask for this once
# (on first load) and remember it in the browser. Treat it like a password.
APP_TOKEN=choose-a-long-random-string

# From https://console.anthropic.com -> API Keys. Powers the Coach tab.
# Without this, the rest of the app still works, the Coach just errors.
ANTHROPIC_API_KEY=sk-ant-...

# Optional, Render sets this automatically in production.
PORT=3000
