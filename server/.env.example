# Copy this file to .env for local development (never commit the real .env).
# On Render, set these as environment variables in the service dashboard instead.

# From https://turso.tech -> create a free database -> "Connect" shows these two:
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# A random secret (long is better: the Render URL is public).
# Generate one with: openssl rand -hex 24
# The app asks for it once (on first load) and remembers it. Treat it like a password.
APP_TOKEN=replace-with-a-long-random-secret

# From https://console.anthropic.com -> API Keys. Powers plans, reviews, the
# Coach and meal analysis; logging works without it. Set a monthly spend limit
# in the console (Settings -> Limits): the deployed URL is public.
ANTHROPIC_API_KEY=sk-ant-...

# Optional, Render sets this automatically in production.
PORT=3000
